APP_ENV=development
APP_NAME=HelaCare API
API_PREFIX=/api/v1

POSTGRES_DB=helacare
POSTGRES_USER=helacare
POSTGRES_PASSWORD=helacare_dev_password
DATABASE_URL=postgresql+asyncpg://helacare:helacare_dev_password@db:5432/helacare
DATABASE_URL_SYNC=postgresql+psycopg://helacare:helacare_dev_password@db:5432/helacare

REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Admin / curator authentication (change in production)
ADMIN_EMAIL=admin@helacare.local
ADMIN_PASSWORD=change-me-now
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=480

# Grounded vector retrieval
RAG_ENABLED=true
RAG_VECTOR_DIMENSIONS=256

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=helacare_grafana
